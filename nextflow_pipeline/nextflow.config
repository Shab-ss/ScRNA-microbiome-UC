params {
    h5ad           = null
    outdir         = 'results'
    counts_layer   = 'counts'          // or 'X'
    sample_key     = 'sample'
    condition_key  = 'condition'
    batch_key      = 'batch'
    celltype_key   = 'cell_type'
    macro_labels   = 'Macrophage'      // comma-separated
    ref_level      = 'control'
    treat_level    = 'DSS'
    min_cells      = 10
    m1_genes       = 'Nos2,Il1b,Tnf,Il6,Cd80,Cd86,Cxcl9,Cxcl10,Stat1'
    m2_genes       = 'Arg1,Mrc1,Cd163,Retnla,Chil3,Il10,Msr1,Stat6'
}


profiles {
    conda {
        conda.enabled  = true
        conda.useMicromamba = true
        conda.cacheDir = "${System.getenv('HOME')}/.nextflow_conda_cache"
        process.conda  = "$projectDir/environment.yml"
        process.beforeScript = 'export PATH="$HOME/.local/bin:$PATH"'
    }
}

executor {
       cpus   = 4
       memory = '12 GB'
   }
process {
       withName: 'scanpy_harmony|pseudobulk' { memory = '8 GB' }
   }